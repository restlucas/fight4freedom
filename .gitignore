# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*

# testing
/coverage
/playwright-report
/test-results
/blob-report
/playwright/.cache

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env*.local

# typescript
*.tsbuildinfo
next-env.d.ts

# editors
.idea
.vscode/*
!.vscode/extensions.json

# claude code (personal settings stay local; .claude/settings.json is shared)
.claude/settings.local.json

# medal artwork lives in the Supabase Storage bucket F4F-Medals, never in the
# repo (see src/features/admin/lib/medal-storage.ts). Anything dropped here is a
# local upload test.
/public/medals/

# roster exports used by pnpm db:import-roster. Kept OUT of the repo and out of
# public/: the dump carries every member's exact platform id, and anything under
# public/ is served as a static file — it would be downloadable from the site.
/data/
