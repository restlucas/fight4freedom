# Copy to .env.local and fill in per project.
# Variables exposed to the browser must be prefixed with NEXT_PUBLIC_.

NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase: DB + Auth + Storage ---
# Prisma needs two connection strings (Supabase > Project Settings > Database).
# DATABASE_URL: runtime queries via the transaction pooler (pgbouncer, port 6543).
DATABASE_URL=postgresql://postgres.[ref]:[password]@[host].pooler.supabase.com:6543/postgres?pgbouncer=true
# DIRECT_URL: schema changes (prisma db push) via the session pooler (port 5432).
DIRECT_URL=postgresql://postgres.[ref]:[password]@[host].pooler.supabase.com:5432/postgres
# Supabase project URL and keys (Supabase > Project Settings > API). Added in Fase 2.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only key for privileged operations (never expose to the browser).
# SUPABASE_SERVICE_ROLE_KEY=

# --- Discord OAuth (Fase 2) ---
# The Discord client id/secret go in the SUPABASE DASHBOARD
# (Authentication > Providers > Discord), never in this repo.
# In the Discord Developer Portal, register this redirect URI:
#   https://<project-ref>.supabase.co/auth/v1/callback
