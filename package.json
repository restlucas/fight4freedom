{
  "name": "fight4freedom",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "worker": "tsx worker/main.ts",
    "worker:local": "dotenv -e .env.local -- tsx worker/main.ts",
    "db:push": "dotenv -e .env.local -- prisma db push && node -e \"console.log('\\n>> REINICIE o pnpm dev.\\n   O Turbopack recarrega codigo-fonte, mas nao recarrega o client do Prisma\\n   (mora em node_modules), entao um dev server ja aberto segue com o client\\n   antigo e quebra em PrismaClientValidationError: Unknown field.\\n')\"",
    "db:generate": "prisma generate",
    "db:studio": "dotenv -e .env.local -- prisma studio",
    "db:seed": "dotenv -e .env.local -- tsx src/lib/db/seed.ts",
    "db:clean-examples": "dotenv -e .env.local -- tsx src/lib/db/clean-examples.ts",
    "db:mock-history": "dotenv -e .env.local -- tsx src/lib/db/mock-history.ts",
    "db:import-roster": "dotenv -e .env.local -- tsx src/lib/db/import-roster.ts",
    "db:resolve-identities": "dotenv -e .env.local -- tsx src/lib/db/resolve-identities.ts",
    "invite:admin": "dotenv -e .env.local -- tsx src/lib/db/bootstrap-invite.ts",
    "postinstall": "prisma generate"
  },
  "pnpm": {
    "overrides": {
      "sharp": "$sharp"
    }
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^0.469.0",
    "next": "^16.2.10",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.7.0",
    "sharp": "^0.34.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.0.0",
    "tsx": "^4.23.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.4",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.18.0",
    "eslint-config-next": "^16.2.10",
    "eslint-config-prettier": "^9.1.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "prisma": "^7.9.0",
    "tailwindcss": "^4.0.0",
    "tw-animate-css": "^1.2.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.0"
  }
}
