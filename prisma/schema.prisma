// Prisma schema — applied with `pnpm db:push` (schema-first, no migration history,
// matching the plan's "push" workflow). See docs/plano.md "Modelo de dados".
// K/D, win-rate and rankings are DERIVED in query/RSC, never persisted.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Prisma 7: connection URLs live in prisma.config.ts (CLI) and the driver
  // adapter in src/lib/db/index.ts (runtime).
}

enum Platform {
  ea
  xbox
  psn

  @@map("platform")
}

enum MemberRole {
  member
  officer
  admin

  @@map("member_role")
}

// Rarity, declared from most common to rarest so `orderBy: { tier: "desc" }`
// lists the rarest first. `special` is reserved for event medals (internal or
// external tournaments), which is why it sits at the top.
enum MedalTier {
  common
  rare
  legendary
  special

  @@map("medal_tier")
}

enum StatSource {
  scraper
  manual
  api

  @@map("stat_source")
}

enum PlayerClass {
  assault
  engineer
  support
  recon

  @@map("player_class")
}

/// Result of the last collection attempt for a member, so the admin panel can
/// tell a working sync from a broken one. Mirrors the outcomes in
/// src/lib/stats/collect.ts, minus `deferred` — a member the run never reached
/// keeps whatever status the previous run gave them, because "we ran out of
/// time" says nothing about whether their data is fetchable.
enum StatsSyncStatus {
  /// Fetched and read. Covers both "counters moved" and "nothing new to record".
  ok
  /// Fetched, but the source has no BF6 data for this identity. Usually means
  /// the platform id resolved to the wrong EA account.
  no_data
  /// No EA identity yet: the platform id does not match any EA account.
  identity_pending

  @@map("stats_sync_status")
}

model Member {
  id       String   @id @default(uuid())
  nickname String
  platform Platform
  /// The member's public id on that platform (gamertag, PSN ID, EA ID). Display
  /// only since 2026-07-28, and optional: it used to double as the EA lookup key,
  /// which is exactly why it failed for console members — EA's search indexes the
  /// EA display name, and a PSN or Xbox gamertag is usually not that name. The
  /// lookup moved to `eaName`; this stays as "how to add this person on their
  /// platform" and is still read as a fallback for rows predating the split.
  platformId String? @map("platform_id")
  /// EA display name, the ONLY field EA's search accepts (`/bf6/player/?name=`).
  /// Optional: an admin who does not know it leaves it blank, which is strictly
  /// better than the invented values a mandatory field produced — 23 of 99
  /// members carried an id that matches no EA account.
  eaName String? @map("ea_name")
  /// EA `username` of the account that was bound, recorded at resolution time.
  /// Output, never input: it is not searchable and not unique (two distinct
  /// accounts share the username `OJUN10R`). Kept because it is the clearest way
  /// for a human to recognise which account was picked.
  eaUsername String? @map("ea_username")
  /// EA persona id + nucleus id: the stable identity the stats API needs.
  /// Resolved automatically from `eaName` (falling back to `platformId`) on member
  /// create/update and self-healed by the collector; never typed by hand.
  /// Account names change, these ids do not — collection survives a rename.
  ///
  /// `eaNucleusId` is the ACCOUNT; `eaPersonaId` is one of its per-platform
  /// personas. One account can own several personas and they all report the same
  /// stats, so which persona is stored does not matter — which account does.
  eaPersonaId String? @map("ea_persona_id")
  eaNucleusId String? @map("ea_nucleus_id")
  /// Discord snowflake, captured from the verified OAuth identity when the
  /// member claims their invite — never typed by hand. Unique so the login
  /// lookup can never be ambiguous.
  discordId     String?    @unique @map("discord_id")
  avatarUrl     String?    @map("avatar_url")
  /// Plain text only, written by the member on their own profile. Rendered as
  /// text (React escapes it); no markup, no links.
  bio           String?
  role          MemberRole @default(member)
  /// Cumulative career points driving the rank ladder in src/lib/ranks.ts.
  ///
  /// Fed by the collector since 2026-07-28: every snapshot credits the points of
  /// the progress since the previous one (`accrueCareerPoints`), so the ladder
  /// moves on its own. Written with `increment`, never as a computed total.
  ///
  /// The starting balance came from the v1 site's rank name via
  /// `pnpm db:import-roster`, and stands in for the career we never watched — a
  /// member's first reading credits nothing, because those lifetime totals were
  /// earned before collection existed. `pnpm db:rebase-ranks` converted those
  /// balances when the ladder was recalibrated.
  rankPoints    Int        @default(0) @map("rank_points")
  joinedAt      DateTime?  @map("joined_at") @db.Date
  active        Boolean    @default(true)
  /// Collect this member's stats even without a verified Discord link.
  ///
  /// The normal rule is that a member enters the collection only after claiming
  /// their invite, because `discordId` proves they did. This flag is the
  /// documented exception, added 2026-07-27 for the one-time import of the 98
  /// members who already existed on the v1 site: they must appear on the vitrine
  /// and score in the ranking without waiting to log in.
  ///
  /// It exists as its own column instead of seeding fake `discordId` values on
  /// purpose. `discordId` is the single field the whole auth flow treats as proof
  /// of identity, and writing invented values into it would work today and become
  /// a trap for whoever next builds on that field.
  ///
  /// Default false, so every member registered from here on follows the invite
  /// flow. Members carrying this flag still need an invite to get a login, a
  /// profile and their Discord avatar.
  collectWithoutLogin Boolean @default(false) @map("collect_without_login")
  /// Admin switch to take a member out of the collection without hiding them
  /// from the vitrine. For when the platform id is known to be wrong: the
  /// alternative was setting `active = false`, which also removes them from
  /// /membros and from the ranking, punishing the member for a data problem.
  statsPaused Boolean @default(false) @map("stats_paused")
  /// When the collector last ATTEMPTED this member, successful or not.
  ///
  /// Needed because a snapshot only exists when counters moved, so the snapshot
  /// table cannot answer "did the last fetch work?" — a member fetched fine with
  /// nothing new to record looks exactly like a member whose fetch failed.
  statsCheckedAt DateTime?        @map("stats_checked_at") @db.Timestamptz(6)
  /// When the collector last SUCCESSFULLY read this member from the source.
  ///
  /// The difference from `statsCheckedAt` is the whole point: that one answers
  /// "when did we last try", this one answers "how old is the data we hold".
  /// Without it the staleness of the roster is unmeasurable — a member can be
  /// attempted every ten minutes for hours and still carry data from yesterday
  /// if every one of those attempts landed in a failed batch, and nothing in
  /// the database would say so.
  ///
  /// Not the same as the newest snapshot either: a member who is read fine but
  /// has not played gets no snapshot, so snapshot age measures playing, not
  /// collecting.
  statsReadAt    DateTime?        @map("stats_read_at") @db.Timestamptz(6)
  /// Outcome of that attempt. Null means never attempted.
  statsStatus    StatsSyncStatus? @map("stats_status")
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  medals     MemberMedal[]
  snapshots  StatSnapshot[]
  highlights Highlight[]
  profiles   Profile[]
  invites    MemberInvite[]

  @@map("member")
}

/// One-time invite that binds a Discord account to a member.
///
/// The link an admin shares carries the plaintext token; only its HASH is stored
/// here, so a database leak cannot be used to claim invites. Claiming is what
/// captures `member.discordId` and what grants admin — the only path that does.
model MemberInvite {
  id       String @id @default(uuid())
  memberId String @map("member_id")
  /// SHA-256 of the token that travels in the link.
  tokenHash String @unique @map("token_hash")
  /// Whether claiming this invite grants system-level admin access.
  grantsAdmin Boolean @default(false) @map("grants_admin")
  /// Label only, so the admin remembers who the link was for. Never used for
  /// authorization — Discord handles are mutable and not unique.
  discordUsername String?  @map("discord_username")
  expiresAt       DateTime @map("expires_at") @db.Timestamptz(6)
  createdBy       String?  @map("created_by")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Set when consumed; the claim only succeeds while this is null.
  usedAt          DateTime? @map("used_at") @db.Timestamptz(6)
  usedByProfileId String?   @map("used_by_profile_id")

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId], map: "member_invite_member_idx")
  @@map("member_invite")
}

model Medal {
  id          String    @id @default(uuid())
  name        String
  description String?
  // Optional: how to earn it ("20 kills without dying").
  criteria    String?
  // Artwork uploaded by an admin (Fase 2: path in the Supabase Storage bucket).
  imageUrl    String?   @map("image_url")
  // Fallback when there is no artwork yet: a curated lucide icon name.
  // See ICONS in src/features/clan/components/medal-emblem.tsx.
  icon        String?
  tier        MedalTier @default(common)
  createdBy   String?   @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  members MemberMedal[]

  @@map("medal")
}

model MemberMedal {
  id        String   @id @default(uuid())
  memberId  String   @map("member_id")
  medalId   String   @map("medal_id")
  awardedAt DateTime @default(now()) @map("awarded_at") @db.Timestamptz(6)
  awardedBy String?  @map("awarded_by")
  note      String?

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  medal  Medal  @relation(fields: [medalId], references: [id], onDelete: Cascade)

  @@unique([memberId, medalId], map: "member_medal_unique")
  @@map("member_medal")
}

model StatSnapshot {
  id                String     @id @default(uuid())
  memberId          String     @map("member_id")
  capturedAt        DateTime   @default(now()) @map("captured_at") @db.Timestamptz(6)
  source            StatSource
  /// Which EA ACCOUNT these cumulative counters came from.
  ///
  /// A snapshot belongs to an account, not to a member: the numbers are lifetime
  /// totals of one EA account, and the monthly ranking scores last-minus-first.
  /// Subtracting across a rebind therefore subtracts one person's career from
  /// another's. That is not hypothetical — it happened on 2026-07-28. Willam had
  /// been bound to a stranger's `Morpheus98` (76 kills); the fix pointed him at
  /// his own account (8.989 kills), and the month's delta became 655 wins and
  /// 2.439 objectives captured, scoring 86.914 points out of nothing.
  ///
  /// `deltaForMonth` now compares only rows carrying the same account, which
  /// makes the guarantee live where the data does. Nullable for rows written
  /// before the column existed; those are backfilled from the member's current
  /// account and treated as belonging to it.
  eaNucleusId       String?    @map("ea_nucleus_id")
  // Raw counters. Matches (wins+losses), K/D, kills-per-match and hours are
  // DERIVED in src/lib/stats/snapshots.ts, never stored.
  kills              Int          @default(0)
  deaths             Int          @default(0)
  wins               Int          @default(0)
  losses             Int          @default(0)
  assists            Int          @default(0)
  revives            Int          @default(0)
  headshots          Int          @default(0)
  objectivesCaptured Int          @default(0) @map("objectives_captured")
  timePlayedMinutes  Int          @default(0) @map("time_played_minutes")
  bestClass          PlayerClass? @map("best_class")
  // Teamwork counters (2026-07-27). The ranking scores teamwork above combat,
  // so these are first-class columns instead of `extra` keys: the monthly delta
  // reads them on every board render, and jsonb would mean parsing on each row.
  objectivesDefended   Int @default(0) @map("objectives_defended")
  objectivesDestroyed  Int @default(0) @map("objectives_destroyed")
  objectivesArmed      Int @default(0) @map("objectives_armed")
  objectivesDisarmed   Int @default(0) @map("objectives_disarmed")
  sectorsDefended      Int @default(0) @map("sectors_defended")
  /** Seconds standing on an objective. Scored per second, at a tiny weight. */
  objectiveTimeSeconds Int @default(0) @map("objective_time_seconds")
  /** Enemies marked for the team. Verified NOT to be Recon-only (see points.ts). */
  spots                Int @default(0)
  /** Hit points restored to teammates — a magnitude, not an action count. */
  healthRestored       Int @default(0) @map("health_restored")
  /**
   * Vehicle repairs. Collected but deliberately NOT scored: it is locked to
   * Engineer, so scoring it taxes everyone who plays another class (decision of
   * 2026-07-27). Stored anyway because history cannot be backfilled if the clan
   * later changes its mind.
   */
  repairs              Int @default(0)
  // Extra BF6 metrics without a migration.
  extra              Json?

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, capturedAt], map: "stat_snapshot_member_captured_idx")
  @@map("stat_snapshot")
}

model Highlight {
  id              String    @id @default(uuid())
  title           String
  description     String?
  memberId        String?   @map("member_id")
  // Path inside the Supabase Storage bucket.
  videoPath       String    @map("video_path")
  thumbnailPath   String?   @map("thumbnail_path")
  durationSeconds Int       @map("duration_seconds")
  playedAt        DateTime? @map("played_at") @db.Date
  featured        Boolean   @default(false)
  createdBy       String?   @map("created_by")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  member Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@map("highlight")
}

// Fase 2 — maps a Supabase auth user to a system role. `id` = auth.users.id.
model Profile {
  id        String   @id
  isAdmin   Boolean  @default(false) @map("is_admin")
  memberId  String?  @map("member_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  member Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@map("profile")
}
