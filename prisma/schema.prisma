// Prisma schema — applied with `pnpm db:push` (schema-first, no migration history,
// matching the plan's "push" workflow). See docs/plano.md "Modelo de dados".
// K/D, win-rate and rankings are DERIVED in query/RSC, never persisted.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Prisma 7: connection URLs live in prisma.config.ts (CLI) and the driver
  // adapter in src/lib/db/index.ts (runtime).
}

enum Platform {
  ea
  xbox
  psn

  @@map("platform")
}

enum MemberRole {
  member
  officer
  admin

  @@map("member_role")
}

// Rarity, declared from most common to rarest so `orderBy: { tier: "desc" }`
// lists the rarest first. `special` is reserved for event medals (internal or
// external tournaments), which is why it sits at the top.
enum MedalTier {
  common
  rare
  legendary
  special

  @@map("medal_tier")
}

enum StatSource {
  scraper
  manual
  api

  @@map("stat_source")
}

/// What kind of thing a `MemberTopItem` row describes.
///
/// Three, because the panel shows three (clan owner, 2026-07-29): the member's best
/// weapon, most-played mode and most-played map. The source also publishes vehicles
/// (22), gadgets (43) and melee in the same payload, so adding a kind later costs an
/// enum value and a selector, not a migration of anything that exists.
enum TopItemKind {
  weapon
  gamemode
  map

  @@map("top_item_kind")
}

enum PlayerClass {
  assault
  engineer
  support
  recon

  @@map("player_class")
}

/// What happened, for the activity feed on the home page.
///
/// Deliberately few kinds. A feed that lists everything lists nothing: the
/// collection runs every 20 minutes over 98 members, so "counters moved" as an
/// event would bury the two things a member actually wants to see.
enum ClanEventKind {
  /// Crossed a rank threshold. Rare, and the only event that is pure good news.
  promotion
  /// A play session, accumulated across consecutive readings — see ClanEvent.
  session

  @@map("clan_event_kind")
}

/// Result of the last collection attempt for a member, so the admin panel can
/// tell a working sync from a broken one. Mirrors the outcomes in
/// src/lib/stats/collect.ts, minus `deferred` — a member the run never reached
/// keeps whatever status the previous run gave them, because "we ran out of
/// time" says nothing about whether their data is fetchable.
enum StatsSyncStatus {
  /// Fetched and read. Covers both "counters moved" and "nothing new to record".
  ok
  /// Fetched, but the source has no BF6 data for this identity. Usually means
  /// the platform id resolved to the wrong EA account.
  no_data
  /// No EA identity yet: the platform id does not match any EA account.
  identity_pending

  @@map("stats_sync_status")
}

/// How one attempt by a MEMBER to declare their own EA account ended.
///
/// Recorded per ATTEMPT, which is why it lives on `identityClaim` and not as a
/// column on `member`: someone who mistypes twice and gets it right on the third
/// try leaves three rows, and the two failures are exactly what an admin needs to
/// see in order to help. A single column would keep only the last one.
enum IdentityClaimOutcome {
  /// EA's search returned nothing for the declared name. The most common failure:
  /// 13 of the 27 unresolved members on 2026-07-29 were in this state, usually a
  /// clan tag typed into a field that matches the whole name (see §11).
  not_found
  /// Exactly one account was found and shown to the member, who has not clicked
  /// yet. Separate from `ambiguous` because the two ask nothing of an admin and
  /// everything of each other: this one usually ends in `confirmed` seconds later,
  /// and a row that stays here means the member walked away from a good match.
  offered
  /// Several DISTINCT EA accounts answer to that name and the member has not
  /// picked one yet. Not an error — the candidate list is the answer.
  ambiguous
  /// An account was found and EA has no BF6 record for it. The §11 case: a real
  /// account that is not this person's.
  empty_profile
  /// The member looked at the account's own numbers and said "this is me". The
  /// only outcome that binds anything.
  confirmed
  /// The source failed (504, timeout). Says nothing about whether the name is
  /// right, so it must never be shown to the member as "not found".
  error

  @@map("identity_claim_outcome")
}

model Member {
  id                  String           @id @default(uuid())
  nickname            String
  platform            Platform
  /// The member's public id on that platform (gamertag, PSN ID, EA ID). Display
  /// only since 2026-07-28, and optional: it used to double as the EA lookup key,
  /// which is exactly why it failed for console members — EA's search indexes the
  /// EA display name, and a PSN or Xbox gamertag is usually not that name. The
  /// lookup moved to `eaName`; this stays as "how to add this person on their
  /// platform" and is still read as a fallback for rows predating the split.
  platformId          String?          @map("platform_id")
  /// EA display name, the ONLY field EA's search accepts (`/bf6/player/?name=`).
  /// Optional: an admin who does not know it leaves it blank, which is strictly
  /// better than the invented values a mandatory field produced — 23 of 99
  /// members carried an id that matches no EA account.
  eaName              String?          @map("ea_name")
  /// EA `username` of the account that was bound, as EA reports it.
  ///
  /// Output, never input, and that survived the identity flow of 2026-07-29 on
  /// purpose. Members now TYPE a username on /confirmar-conta, but that string
  /// lands in `identityClaim.declaredUsername`, never here: it is not searchable
  /// and not unique (two distinct accounts share the username `OJUN10R`), so its
  /// only job is breaking a tie between candidates. This column stays "what EA
  /// says the bound account is called", which is what makes it trustworthy in the
  /// panel.
  eaUsername          String?          @map("ea_username")
  /// EA persona id + nucleus id: the stable identity the stats API needs.
  /// Resolved automatically from `eaName` (falling back to `platformId`) on member
  /// create/update and self-healed by the collector; never typed by hand.
  /// Account names change, these ids do not — collection survives a rename.
  ///
  /// `eaNucleusId` is the ACCOUNT; `eaPersonaId` is one of its per-platform
  /// personas. One account can own several personas and they all report the same
  /// stats, so which persona is stored does not matter — which account does.
  eaPersonaId         String?          @map("ea_persona_id")
  eaNucleusId         String?          @map("ea_nucleus_id")
  /// When the MEMBER THEMSELF looked at the bound account's numbers and confirmed
  /// it is theirs.
  ///
  /// The difference from `eaPersonaId` being filled is the whole point, and it is
  /// what §11 of docs/api-gametools.md cost us: an id resolved from a name is a
  /// GUESS an admin made, and on 2026-07-28 ten members were bound to accounts
  /// that existed and were not theirs. Nothing in the database could tell those
  /// apart from a correct bind. This column can: only a human who knows the answer
  /// sets it.
  ///
  /// Null is the gate. An unconfirmed member is sent to /confirmar-conta on login
  /// and cannot leave the site's pages until they confirm or ask for help.
  ///
  /// Cleared when an admin rebinds the member to a DIFFERENT EA account, because
  /// the member's agreement was about the old one and says nothing about the new.
  identityConfirmedAt DateTime?        @map("identity_confirmed_at") @db.Timestamptz(6)
  /// When the member gave up and asked an admin to sort their account out.
  ///
  /// The gate's ESCAPE HATCH, and it has to exist: without it, a member whose EA
  /// name genuinely resolves to nothing (4 of the 27 on 2026-07-29 exist on no
  /// source at all) would be held on the confirmation screen forever, unable to
  /// use the site they were invited to.
  ///
  /// Its own column rather than a read of `identityClaim.needsHelp` because the
  /// gate runs on every navigation and rides along in the session query
  /// (getSessionProfile), where one more column costs nothing and a second query
  /// would cost a round trip per page. The claim rows keep the per-attempt detail.
  identityHelpRequestedAt DateTime?    @map("identity_help_requested_at") @db.Timestamptz(6)
  /// In-game BF6 rank, as the game words it ("Second Lieutenant V"), plus the
  /// numeric level behind it and the insignia EA serves.
  ///
  /// STATE, NOT HISTORY, which is why these live here and not on `statSnapshot`.
  /// A level moves every few dozen hours of play, so a per-reading series of it
  /// would be 72 identical rows a day per member to record a value that changed
  /// twice a month.
  ///
  /// They do NOT feed `rankPoints` and never will. Our ladder is calibrated on
  /// teamwork (150 pts/h measured, see src/lib/ranks.ts) and the game's rewards
  /// time and personal performance; wiring one into the other would undo the
  /// scoring decision of 2026-07-27 without anyone deciding it. This is a badge
  /// shown beside ours, not an input to it.
  gameRankName        String?          @map("game_rank_name")
  gameRankLevel       Int?             @map("game_rank_level")
  gameRankImageUrl    String?          @map("game_rank_image_url")
  /// Badges and dog tags the account has collected.
  ///
  /// COUNTS ONLY, and that is the source's ceiling rather than a first version:
  /// `/bf6/profile/` publishes `playerCard.badges` and `totalDogTags.intValue` as
  /// integers, and the 18 BF6 endpoints were swept on 2026-07-29 looking for a
  /// catalogue of WHICH ones. There is none (docs/api-gametools.md §13.4), so a
  /// collection wall here would have to be filled in by hand.
  badgeCount          Int?             @map("badge_count")
  dogTagCount         Int?             @map("dog_tag_count")
  /// Ranked division in Redsec, and which mode it was earned in.
  ///
  /// Null covers two different things, told apart by `gameProfileReadAt`: never
  /// collected, or collected and unranked. Unranked is stored as null on purpose,
  /// because the profile only earns a tile when there is a division to show and
  /// most of the roster will never have one.
  competitiveRankName String?          @map("competitive_rank_name")
  competitiveRankMode String?          @map("competitive_rank_mode")
  /// When the profile endpoint was last ATTEMPTED for this member.
  ///
  /// Stamped on every attempt, successful or not, and that is load-bearing: it is
  /// the queue order for the profile pass, and a member whose profile always fails
  /// would otherwise sit at the front of it forever, starving everyone behind
  /// them. That exact failure cost 21 consecutive cycles of identity resolution in
  /// 2026-07-28 (see "Fila da coleta" in docs/plano.md); the fix is the same here.
  gameProfileReadAt   DateTime?        @map("game_profile_read_at") @db.Timestamptz(6)
  /// Discord snowflake, captured from the verified OAuth identity when the
  /// member claims their invite — never typed by hand. Unique so the login
  /// lookup can never be ambiguous.
  discordId           String?          @unique @map("discord_id")
  avatarUrl           String?          @map("avatar_url")
  /// Plain text only, written by the member on their own profile. Rendered as
  /// text (React escapes it); no markup, no links.
  bio                 String?
  role                MemberRole       @default(member)
  /// Cumulative career points driving the rank ladder in src/lib/ranks.ts.
  ///
  /// Fed by the collector since 2026-07-28: every snapshot credits the points of
  /// the progress since the previous one (`accrueCareerPoints`), so the ladder
  /// moves on its own. Written with `increment`, never as a computed total.
  ///
  /// The starting balance came from the v1 site's rank name via
  /// `pnpm db:import-roster`, and stands in for the career we never watched — a
  /// member's first reading credits nothing, because those lifetime totals were
  /// earned before collection existed. `pnpm db:rebase-ranks` converted those
  /// balances when the ladder was recalibrated.
  rankPoints          Int              @default(0) @map("rank_points")
  joinedAt            DateTime?        @map("joined_at") @db.Date
  active              Boolean          @default(true)
  /// Collect this member's stats even without a verified Discord link.
  ///
  /// The normal rule is that a member enters the collection only after claiming
  /// their invite, because `discordId` proves they did. This flag is the
  /// documented exception, added 2026-07-27 for the one-time import of the 98
  /// members who already existed on the v1 site: they must appear on the vitrine
  /// and score in the ranking without waiting to log in.
  ///
  /// It exists as its own column instead of seeding fake `discordId` values on
  /// purpose. `discordId` is the single field the whole auth flow treats as proof
  /// of identity, and writing invented values into it would work today and become
  /// a trap for whoever next builds on that field.
  ///
  /// Default false, so every member registered from here on follows the invite
  /// flow. Members carrying this flag still need an invite to get a login, a
  /// profile and their Discord avatar.
  collectWithoutLogin Boolean          @default(false) @map("collect_without_login")
  /// Admin switch to take a member out of the collection without hiding them
  /// from the vitrine. For when the platform id is known to be wrong: the
  /// alternative was setting `active = false`, which also removes them from
  /// /membros and from the ranking, punishing the member for a data problem.
  statsPaused         Boolean          @default(false) @map("stats_paused")
  /// Why the collection is paused, in one line, for the admin panel.
  ///
  /// Exists because the flag above had exactly one state for two very different
  /// situations: "an admin paused this on purpose" and "the member tried to
  /// identify their own account and could not". The second is a queue item that
  /// someone has to work; the first is a decision nobody should undo. Free text
  /// rather than an enum: it is read by a human and never branched on.
  statsPausedReason   String?          @map("stats_paused_reason")
  /// When the collector last ATTEMPTED this member, successful or not.
  ///
  /// Needed because a snapshot only exists when counters moved, so the snapshot
  /// table cannot answer "did the last fetch work?" — a member fetched fine with
  /// nothing new to record looks exactly like a member whose fetch failed.
  statsCheckedAt      DateTime?        @map("stats_checked_at") @db.Timestamptz(6)
  /// When the collector last SUCCESSFULLY read this member from the source.
  ///
  /// The difference from `statsCheckedAt` is the whole point: that one answers
  /// "when did we last try", this one answers "how old is the data we hold".
  /// Without it the staleness of the roster is unmeasurable — a member can be
  /// attempted every ten minutes for hours and still carry data from yesterday
  /// if every one of those attempts landed in a failed batch, and nothing in
  /// the database would say so.
  ///
  /// Not the same as the newest snapshot either: a member who is read fine but
  /// has not played gets no snapshot, so snapshot age measures playing, not
  /// collecting.
  statsReadAt         DateTime?        @map("stats_read_at") @db.Timestamptz(6)
  /// Outcome of that attempt. Null means never attempted.
  statsStatus         StatsSyncStatus? @map("stats_status")
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  medals          MemberMedal[]
  topItems        MemberTopItem[]
  snapshots       StatSnapshot[]
  highlights      Highlight[]
  profiles        Profile[]
  invites         MemberInvite[]
  events          ClanEvent[]
  identityClaims  IdentityClaim[]

  @@map("member")
}

/// One attempt by a member to declare which EA account is theirs.
///
/// APPEND-ONLY, and the reason is the failure path. When the search returns
/// nothing there is no candidate to copy anything from, so the string the member
/// typed is the ONLY record of what was tried — and that string is the entire
/// content of the admin's queue item. Storing it as a column on `member` would
/// keep just the last attempt and would mix "what the person said" with "what we
/// resolved", which is precisely the comparison a human needs in order to guess
/// the right name.
///
/// On the happy path these rows are only history: `member.eaName`, `eaUsername`
/// and the two ids are overwritten from the CONFIRMED candidate, so nothing here
/// is read by the collector.
model IdentityClaim {
  id               String               @id @default(uuid())
  memberId         String               @map("member_id")
  /// Exactly what the member typed, trimmed but never normalised: the accents,
  /// the clan tag and the casing are the evidence.
  declaredName     String               @map("declared_name")
  /// The EA `username` they typed. Mandatory in the form (clan owner's decision,
  /// 2026-07-29) even though it is neither searchable nor unique, because it is a
  /// legitimate tiebreak between same-named accounts (pickIdentity, step 3).
  declaredUsername String               @map("declared_username")
  outcome          IdentityClaimOutcome
  /// The member ticked "não consegui". A PRIORITY signal, not the record itself:
  /// the row is written on every failed attempt, so someone who gives up in
  /// silence is still visible in the queue.
  needsHelp        Boolean              @default(false) @map("needs_help")
  /// Which account was bound, for a `confirmed` row. Duplicated from `member` on
  /// purpose: an admin may later change those columns, and this is the record of
  /// what the member actually vouched for.
  eaPersonaId      String?              @map("ea_persona_id")
  eaNucleusId      String?              @map("ea_nucleus_id")
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  /// The queue reads "latest attempt per member"; both filters hit this.
  @@index([memberId, createdAt], map: "identity_claim_member_created_idx")
  @@map("identity_claim")
}

/// One-time invite that binds a Discord account to a member.
///
/// The link an admin shares carries the plaintext token; only its HASH is stored
/// here, so a database leak cannot be used to claim invites. Claiming is what
/// captures `member.discordId` and what grants admin — the only path that does.
model MemberInvite {
  id              String    @id @default(uuid())
  memberId        String    @map("member_id")
  /// SHA-256 of the token that travels in the link.
  tokenHash       String    @unique @map("token_hash")
  /// Whether claiming this invite grants system-level admin access.
  grantsAdmin     Boolean   @default(false) @map("grants_admin")
  /// Label only, so the admin remembers who the link was for. Never used for
  /// authorization — Discord handles are mutable and not unique.
  discordUsername String?   @map("discord_username")
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(6)
  createdBy       String?   @map("created_by")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Set when consumed; the claim only succeeds while this is null.
  usedAt          DateTime? @map("used_at") @db.Timestamptz(6)
  usedByProfileId String?   @map("used_by_profile_id")

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId], map: "member_invite_member_idx")
  @@map("member_invite")
}

model Medal {
  id          String    @id @default(uuid())
  name        String
  description String?
  // Optional: how to earn it ("20 kills without dying").
  criteria    String?
  // Artwork uploaded by an admin (Fase 2: path in the Supabase Storage bucket).
  imageUrl    String?   @map("image_url")
  // Fallback when there is no artwork yet: a curated lucide icon name.
  // See ICONS in src/features/clan/components/medal-emblem.tsx.
  icon        String?
  tier        MedalTier @default(common)
  createdBy   String?   @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  members MemberMedal[]

  @@map("medal")
}

model MemberMedal {
  id        String   @id @default(uuid())
  memberId  String   @map("member_id")
  medalId   String   @map("medal_id")
  awardedAt DateTime @default(now()) @map("awarded_at") @db.Timestamptz(6)
  awardedBy String?  @map("awarded_by")
  note      String?

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  medal  Medal  @relation(fields: [medalId], references: [id], onDelete: Cascade)

  @@unique([memberId, medalId], map: "member_medal_unique")
  @@map("member_medal")
}

model StatSnapshot {
  id                   String       @id @default(uuid())
  memberId             String       @map("member_id")
  capturedAt           DateTime     @default(now()) @map("captured_at") @db.Timestamptz(6)
  source               StatSource
  /// Which EA ACCOUNT these cumulative counters came from.
  ///
  /// A snapshot belongs to an account, not to a member: the numbers are lifetime
  /// totals of one EA account, and the monthly ranking scores last-minus-first.
  /// Subtracting across a rebind therefore subtracts one person's career from
  /// another's. That is not hypothetical — it happened on 2026-07-28. Willam had
  /// been bound to a stranger's `Morpheus98` (76 kills); the fix pointed him at
  /// his own account (8.989 kills), and the month's delta became 655 wins and
  /// 2.439 objectives captured, scoring 86.914 points out of nothing.
  ///
  /// `deltaForMonth` now compares only rows carrying the same account, which
  /// makes the guarantee live where the data does. Nullable for rows written
  /// before the column existed; those are backfilled from the member's current
  /// account and treated as belonging to it.
  eaNucleusId          String?      @map("ea_nucleus_id")
  // Raw counters. Matches (wins+losses), K/D, kills-per-match and hours are
  // DERIVED in src/lib/stats/snapshots.ts, never stored.
  kills                Int          @default(0)
  deaths               Int          @default(0)
  wins                 Int          @default(0)
  losses               Int          @default(0)
  assists              Int          @default(0)
  revives              Int          @default(0)
  headshots            Int          @default(0)
  objectivesCaptured   Int          @default(0) @map("objectives_captured")
  timePlayedMinutes    Int          @default(0) @map("time_played_minutes")
  bestClass            PlayerClass? @map("best_class")
  // Teamwork counters (2026-07-27). The ranking scores teamwork above combat,
  // so these are first-class columns instead of `extra` keys: the monthly delta
  // reads them on every board render, and jsonb would mean parsing on each row.
  objectivesDefended   Int          @default(0) @map("objectives_defended")
  objectivesDestroyed  Int          @default(0) @map("objectives_destroyed")
  objectivesArmed      Int          @default(0) @map("objectives_armed")
  objectivesDisarmed   Int          @default(0) @map("objectives_disarmed")
  sectorsDefended      Int          @default(0) @map("sectors_defended")
  /**
   * Seconds standing on an objective. Scored per second, at a tiny weight.
   */
  objectiveTimeSeconds Int          @default(0) @map("objective_time_seconds")
  /**
   * Enemies marked for the team. Verified NOT to be Recon-only (see points.ts).
   */
  spots                Int          @default(0)
  /**
   * Hit points restored to teammates — a magnitude, not an action count.
   */
  healthRestored       Int          @default(0) @map("health_restored")
  /**
   * Vehicle repairs. Collected but deliberately NOT scored: it is locked to
   * Engineer, so scoring it taxes everyone who plays another class (decision of
   * 2026-07-27). Stored anyway because history cannot be backfilled if the clan
   * later changes its mind.
   */
  repairs              Int          @default(0)
  /**
   * Account XP: lifetime total, and the performance and accolade slices of it.
   *
   * Free, which is why they are here: they ride in the `XP` array of the stats
   * payload the collector ALREADY downloads (721 KB per player, see
   * docs/api-gametools.md §13.1), so no extra request buys them.
   *
   * Columns rather than `extra` keys because the profile reads the newest snapshot
   * on every render, and jsonb would mean parsing per row. Being a monotonic
   * counter like every other column here, XP is also a progression series for
   * free.
   *
   * NOT scored. See the game rank columns on `member` for why.
   *
   * A row with 0 is a row written before these existed, not an account with no
   * XP: a profile empty enough to have none is refused by `toRawStats` before it
   * reaches a snapshot. Callers render 0 as "unknown".
   */
  xpTotal              Int          @default(0) @map("xp_total")
  xpPerformance        Int          @default(0) @map("xp_performance")
  xpAccolades          Int          @default(0) @map("xp_accolades")
  // Extra BF6 metrics without a migration.
  extra                Json?

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, capturedAt], map: "stat_snapshot_member_captured_idx")
  @@map("stat_snapshot")
}

/// Fase 10 — the ONE best weapon, most-played mode and most-played map per member.
///
/// THE TOP, NOT AN ARSENAL, and the name says so on purpose. Exactly one row per
/// member per kind, so any sum over this table is biased toward whatever is already
/// popular: it answers "what does this member play" and can never answer "what does
/// the clan play". A clan-wide aggregate needs the full 152 items collected, which is
/// deliberately out of scope (see docs/plano.md, Fases 9 a 12).
///
/// STATE, NOT HISTORY. The source publishes lifetime totals, so the row is rewritten
/// in place on every reading that moved. Keeping a series would mean ~1,07 million
/// rows a day at 98 members and 72 cycles for a value that changes a few times a
/// week; this way the table sits at ~294 rows forever.
///
/// Storing less is safe here for a reason specific to this data: the source is
/// idempotent lifetime state, so nothing is ever lost by not keeping it. If the clan
/// later wants the top three weapons, the constant changes and the next cycle fills
/// them in — no backfill, because there is no history to reconstruct.
///
/// Not columns on `member` (13 of them would be needed) precisely because of item 7
/// of the Backlog técnico: display-only columns with a single implicit writer are how
/// the panel and the collector end up disagreeing.
model MemberTopItem {
  id       String      @id @default(uuid())
  memberId String      @map("member_id")
  kind     TopItemKind
  /// Id as the source spells it: "wp_mg_l110", "lvlmpabbasid", "gm_esc".
  itemId   String      @map("item_id")
  name     String
  /// "Machine Guns" for a weapon. Null for a map or a mode, which have no grouping.
  group    String?
  /// Artwork on the source's CDN. `.webp` for weapons and maps; modes are `.svg` and
  /// are deliberately NOT rendered through next/image — see the panel component.
  imageUrl String?     @map("image_url")
  /// Which EA ACCOUNT these numbers came from. Same reason as `statSnapshot`: a
  /// rebind makes them somebody else's, and a `deleteMany` by account is the fix.
  eaNucleusId String?  @map("ea_nucleus_id")
  // Shared counters, hot because they are what the panel reads and what any future
  // ordering would sort by. Zero where the kind has no such notion.
  kills       Int      @default(0)
  matches     Int      @default(0)
  wins        Int      @default(0)
  losses      Int      @default(0)
  /// Seconds equipped (weapon) or played (map, mode).
  secondsUsed Int      @default(0) @map("seconds_used")
  /// Per-kind extras: `accuracy` and `headshotKills` for a weapon. Jsonb because
  /// they exist for one kind out of three and nothing sorts by them.
  metrics  Json?
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  /// One row per member per kind. With a single item per kind there is no position to
  /// store, and that is what bounds the table by construction: no upsert can make it
  /// grow. Wanting a top three is exactly what would bring a `rank` column back.
  @@unique([memberId, kind], map: "member_top_item_unique")
  @@map("member_top_item")
}

model Highlight {
  id              String    @id @default(uuid())
  title           String
  description     String?
  memberId        String?   @map("member_id")
  // Path inside the Supabase Storage bucket.
  videoPath       String    @map("video_path")
  thumbnailPath   String?   @map("thumbnail_path")
  durationSeconds Int       @map("duration_seconds")
  playedAt        DateTime? @map("played_at") @db.Date
  featured        Boolean   @default(false)
  createdBy       String?   @map("created_by")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  member Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@map("highlight")
}

// Fase 2 — maps a Supabase auth user to a system role. `id` = auth.users.id.
model Profile {
  id        String   @id
  isAdmin   Boolean  @default(false) @map("is_admin")
  memberId  String?  @map("member_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  member Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@map("profile")
}

/// Fase 8 — one row per notable thing that happened, for the home page feed.
///
/// WRITTEN, NOT DERIVED, and that is the whole design decision. A promotion is
/// only knowable at the instant it happens: the collector is the one thing that
/// sees "this member had 1.980 points and now has 2.040". Reconstructing it later
/// from `member.rankPoints` would mean subtracting past deltas from a mutable
/// running total, which is exactly the class of reasoning that produced 86.914
/// points for 301 minutes of play (see deltaForMonth). Append a row when it
/// happens and the feed is a read.
///
/// It is also the queue the Discord webhook will consume when that ships
/// (docs/plano.md > Backlog técnico): the producer already exists.
model ClanEvent {
  id            String        @id @default(uuid())
  memberId      String        @map("member_id")
  kind          ClanEventKind
  /// When it started. For a session, the first reading that credited points.
  occurredAt    DateTime      @default(now()) @map("occurred_at") @db.Timestamptz(6)
  /// Last time the row changed, and the feed's CURSOR — not just bookkeeping.
  /// A session grows while the member keeps playing, so "what is new since I
  /// loaded the page" cannot be answered by `occurredAt` or by the id.
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// Career points the event is worth. Accumulates for a session.
  points        Int           @default(0)
  /// Minutes played, so a session can be described in the unit members think in.
  minutesPlayed Int           @default(0) @map("minutes_played")
  /// Rank reached, for a promotion. Slug (not name) because it also addresses the
  /// insignia artwork in public/patentes.
  rankSlug      String?       @map("rank_slug")

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  /// The feed reads by recency and polls by cursor; both hit this.
  @@index([updatedAt], map: "clan_event_updated_idx")
  /// Finding a member's open session, once per collected batch.
  @@index([memberId, kind, occurredAt], map: "clan_event_member_kind_idx")
  @@map("clan_event")
}
