// Prisma schema — applied with `pnpm db:push` (schema-first, no migration history,
// matching the plan's "push" workflow). See docs/plano.md "Modelo de dados".
// K/D, win-rate and rankings are DERIVED in query/RSC, never persisted.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Prisma 7: connection URLs live in prisma.config.ts (CLI) and the driver
  // adapter in src/lib/db/index.ts (runtime).
}

enum Platform {
  ea
  xbox
  psn

  @@map("platform")
}

enum MemberRole {
  member
  officer
  admin

  @@map("member_role")
}

// Rarity, declared from most common to rarest so `orderBy: { tier: "desc" }`
// lists the rarest first. `special` is reserved for event medals (internal or
// external tournaments), which is why it sits at the top.
enum MedalTier {
  common
  rare
  legendary
  special

  @@map("medal_tier")
}

enum StatSource {
  scraper
  manual
  api

  @@map("stat_source")
}

enum PlayerClass {
  assault
  engineer
  support
  recon

  @@map("player_class")
}

model Member {
  id       String   @id @default(uuid())
  nickname String
  platform Platform
  /// The member's exact public id on that platform (EA ID, gamertag, PSN ID).
  /// Shown on hover over the platform icon AND used as the lookup key that
  /// resolves the EA identity below — so it must match the account exactly.
  /// Mandatory in the admin form; nullable here only for rows created before
  /// that rule existed.
  platformId String? @map("platform_id")
  /// EA persona id + nucleus id: the stable identity the stats API needs.
  /// Resolved automatically from `platformId` (gametools /bf6/player/) on member
  /// create/update and self-healed by the collector; never typed by hand.
  /// Account names change, these ids do not — collection survives a rename.
  eaPersonaId String? @map("ea_persona_id")
  eaNucleusId String? @map("ea_nucleus_id")
  /// Discord snowflake, captured from the verified OAuth identity when the
  /// member claims their invite — never typed by hand. Unique so the login
  /// lookup can never be ambiguous.
  discordId     String?    @unique @map("discord_id")
  avatarUrl     String?    @map("avatar_url")
  /// Plain text only, written by the member on their own profile. Rendered as
  /// text (React escapes it); no markup, no links.
  bio           String?
  role          MemberRole @default(member)
  /// Cumulative career points driving the rank ladder in src/lib/ranks.ts.
  /// Seeded with mock values until the scoring rules are defined.
  rankPoints    Int        @default(0) @map("rank_points")
  joinedAt      DateTime?  @map("joined_at") @db.Date
  active        Boolean    @default(true)
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  medals     MemberMedal[]
  snapshots  StatSnapshot[]
  highlights Highlight[]
  profiles   Profile[]
  invites    MemberInvite[]

  @@map("member")
}

/// One-time invite that binds a Discord account to a member.
///
/// The link an admin shares carries the plaintext token; only its HASH is stored
/// here, so a database leak cannot be used to claim invites. Claiming is what
/// captures `member.discordId` and what grants admin — the only path that does.
model MemberInvite {
  id       String @id @default(uuid())
  memberId String @map("member_id")
  /// SHA-256 of the token that travels in the link.
  tokenHash String @unique @map("token_hash")
  /// Whether claiming this invite grants system-level admin access.
  grantsAdmin Boolean @default(false) @map("grants_admin")
  /// Label only, so the admin remembers who the link was for. Never used for
  /// authorization — Discord handles are mutable and not unique.
  discordUsername String?  @map("discord_username")
  expiresAt       DateTime @map("expires_at") @db.Timestamptz(6)
  createdBy       String?  @map("created_by")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Set when consumed; the claim only succeeds while this is null.
  usedAt          DateTime? @map("used_at") @db.Timestamptz(6)
  usedByProfileId String?   @map("used_by_profile_id")

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId], map: "member_invite_member_idx")
  @@map("member_invite")
}

model Medal {
  id          String    @id @default(uuid())
  name        String
  description String?
  // Optional: how to earn it ("20 kills without dying").
  criteria    String?
  // Artwork uploaded by an admin (Fase 2: path in the Supabase Storage bucket).
  imageUrl    String?   @map("image_url")
  // Fallback when there is no artwork yet: a curated lucide icon name.
  // See ICONS in src/features/clan/components/medal-emblem.tsx.
  icon        String?
  tier        MedalTier @default(common)
  createdBy   String?   @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  members MemberMedal[]

  @@map("medal")
}

model MemberMedal {
  id        String   @id @default(uuid())
  memberId  String   @map("member_id")
  medalId   String   @map("medal_id")
  awardedAt DateTime @default(now()) @map("awarded_at") @db.Timestamptz(6)
  awardedBy String?  @map("awarded_by")
  note      String?

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  medal  Medal  @relation(fields: [medalId], references: [id], onDelete: Cascade)

  @@unique([memberId, medalId], map: "member_medal_unique")
  @@map("member_medal")
}

model StatSnapshot {
  id                String     @id @default(uuid())
  memberId          String     @map("member_id")
  capturedAt        DateTime   @default(now()) @map("captured_at") @db.Timestamptz(6)
  source            StatSource
  // Raw counters. Matches (wins+losses), K/D, kills-per-match and hours are
  // DERIVED in src/lib/stats/snapshots.ts, never stored.
  kills              Int          @default(0)
  deaths             Int          @default(0)
  wins               Int          @default(0)
  losses             Int          @default(0)
  assists            Int          @default(0)
  revives            Int          @default(0)
  headshots          Int          @default(0)
  objectivesCaptured Int          @default(0) @map("objectives_captured")
  timePlayedMinutes  Int          @default(0) @map("time_played_minutes")
  bestClass          PlayerClass? @map("best_class")
  // Teamwork counters (2026-07-27). The ranking scores teamwork above combat,
  // so these are first-class columns instead of `extra` keys: the monthly delta
  // reads them on every board render, and jsonb would mean parsing on each row.
  objectivesDefended   Int @default(0) @map("objectives_defended")
  objectivesDestroyed  Int @default(0) @map("objectives_destroyed")
  objectivesArmed      Int @default(0) @map("objectives_armed")
  objectivesDisarmed   Int @default(0) @map("objectives_disarmed")
  sectorsDefended      Int @default(0) @map("sectors_defended")
  /** Seconds standing on an objective. Scored per second, at a tiny weight. */
  objectiveTimeSeconds Int @default(0) @map("objective_time_seconds")
  /** Enemies marked for the team. Verified NOT to be Recon-only (see points.ts). */
  spots                Int @default(0)
  /** Hit points restored to teammates — a magnitude, not an action count. */
  healthRestored       Int @default(0) @map("health_restored")
  /**
   * Vehicle repairs. Collected but deliberately NOT scored: it is locked to
   * Engineer, so scoring it taxes everyone who plays another class (decision of
   * 2026-07-27). Stored anyway because history cannot be backfilled if the clan
   * later changes its mind.
   */
  repairs              Int @default(0)
  // Extra BF6 metrics without a migration.
  extra              Json?

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, capturedAt], map: "stat_snapshot_member_captured_idx")
  @@map("stat_snapshot")
}

model Highlight {
  id              String    @id @default(uuid())
  title           String
  description     String?
  memberId        String?   @map("member_id")
  // Path inside the Supabase Storage bucket.
  videoPath       String    @map("video_path")
  thumbnailPath   String?   @map("thumbnail_path")
  durationSeconds Int       @map("duration_seconds")
  playedAt        DateTime? @map("played_at") @db.Date
  featured        Boolean   @default(false)
  createdBy       String?   @map("created_by")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  member Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@map("highlight")
}

// Fase 2 — maps a Supabase auth user to a system role. `id` = auth.users.id.
model Profile {
  id        String   @id
  isAdmin   Boolean  @default(false) @map("is_admin")
  memberId  String?  @map("member_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  member Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@map("profile")
}
